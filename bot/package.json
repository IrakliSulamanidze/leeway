{
  "name": "leeway-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "chat": "node --import ./scripts/register.mjs scripts/chat.ts",
    "pilot": "node --import ./scripts/register.mjs src/adapters/whatsapp-web/main.ts",
    "boundaries": "node scripts/boundaries.mjs",
    "eval:reader": "node --import ./scripts/register.mjs scripts/eval-reader.ts",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
