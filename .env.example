# Copy to .env.local and fill in. Names only here, never real values.
# Browser (public by design): only these may reach the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Read at build time: set it in Vercel before the production build.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only
SUPABASE_SECRET_KEY=
CRON_SECRET=
GEMINI_API_KEY=
# Optional: the syllabus read has defaults for both.
GEMINI_MODEL=
GEMINI_MODEL_FALLBACK=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
